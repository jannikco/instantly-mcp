  "connector": {
    "id": "instantly",
    "name": "Instantly",
    "version": "0.1.0",
    "baseUrl": "https://api.instantly.ai/api/v2",
    "auth": {
      "type": "bearer",
      "env": "INSTANTLY_API_KEY"
    },
    "tools": [
      {
        "name": "instantly_list_campaigns",
        "description": "Read one bounded page of campaigns.",
        "method": "GET",
        "path": "/campaigns",
        "readOnly": true,
        "approvalRequired": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "starting_after": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {
            "limit": "limit",
            "starting_after": "starting_after"
          },
          "body": {}
        },
        "sampleArguments": {
          "limit": 10
        },
        "evidence": {
          "state": "documented",
          "providerLiveValidation": "not-run"
        },
        "provenance": [
          "https://api.instantly.ai/openapi/api_v2.json"
        ]
      },
      {
        "name": "instantly_create_campaign",
        "description": "Create campaign configuration with a required schedule; no activation or sending tool is exposed.",
        "method": "POST",
        "path": "/campaigns",
        "readOnly": false,
        "approvalRequired": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "campaign_schedule": {
              "type": "object",
              "properties": {
                "schedules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timing": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "to": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                          }
                        },
                        "required": [
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      },
                      "days": {
                        "type": "object",
                        "properties": {
                          "1": {
                            "type": "boolean"
                          },
                          "2": {
                            "type": "boolean"
                          },
                          "3": {
                            "type": "boolean"
                          },
                          "4": {
                            "type": "boolean"
                          },
                          "5": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "1",
                          "2",
                          "3",
                          "4",
                          "5"
                        ],
                        "additionalProperties": false
                      },
                      "timezone": {
                        "type": "string",
                        "enum": [
                          "Europe/Paris",
                          "America/New_York"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "timing",
                      "days",
                      "timezone"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "schedules"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "campaign_schedule"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [],
          "query": {},
          "body": {
            "name": "name",
            "campaign_schedule": "campaign_schedule"
          }
        },
        "sampleArguments": {
          "name": "Sandbox draft campaign",
          "campaign_schedule": {
            "schedules": [
              {
                "name": "Weekday review window",
                "timing": {
                  "from": "09:00",
                  "to": "17:00"
                },
                "days": {
                  "1": true,
                  "2": true,
                  "3": true,
                  "4": true,
                  "5": true
                },
                "timezone": "Europe/Paris"
              }
            ]
          }
        },
        "evidence": {
          "state": "documented",
          "providerLiveValidation": "not-run"
        },
        "provenance": [
          "https://api.instantly.ai/openapi/api_v2.json"
        ]
      }
    ],
    "workflow": {
      "name": "Instantly authorized workflow",
      "description": "Inspect campaigns and explicitly create a new campaign with a reviewed schedule, without activating it.",
      "steps": [
        "instantly_list_campaigns",
