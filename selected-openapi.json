{
  "openapi": "3.1.0",
  "info": {
    "title": "Instantly selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.instantly.ai/api/v2"
    }
  ],
  "paths": {
    "/campaigns": {
      "get": {
        "operationId": "instantly_list_campaigns",
        "summary": "Read one bounded page of campaigns.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "instantly_create_campaign",
        "summary": "Create campaign configuration with a required schedule; no activation or sending tool is exposed.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "campaign_schedule": {
                    "type": "object",
                    "properties": {
                      "schedules": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "timing": {
                              "type": "object",
                              "properties": {
                                "from": {
                                  "type": "string",
                                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                                },
                                "to": {
                                  "type": "string",
                                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                                }
                              },
                              "required": [
                                "from",
                                "to"
                              ],
                              "additionalProperties": false
                            },
                            "days": {
                              "type": "object",
                              "properties": {
                                "1": {
                                  "type": "boolean"
                                },
                                "2": {
                                  "type": "boolean"
                                },
                                "3": {
                                  "type": "boolean"
                                },
                                "4": {
                                  "type": "boolean"
                                },
                                "5": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "1",
                                "2",
                                "3",
                                "4",
                                "5"
                              ],
                              "additionalProperties": false
                            },
                            "timezone": {
                              "type": "string",
                              "enum": [
                                "Europe/Paris",
                                "America/New_York"
                              ]
                            }
                          },
                          "required": [
                            "name",
                            "timing",
                            "days",
                            "timezone"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "schedules"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "campaign_schedule"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
